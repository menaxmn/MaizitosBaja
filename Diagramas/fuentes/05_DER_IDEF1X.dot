digraph ER {
  graph [rankdir=LR, fontname="Arial", fontsize=18, label="Maizitos Baja · DER en notación IDEF1X", labelloc=t, pad=0.3, nodesep=0.45, ranksep=1.3, splines=true, dpi=120];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#333333"];
  Articulo [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD><B>Articulo</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_ArticuloId"><FONT POINT-SIZE="10"><B>ArticuloId</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_CategoriaId"><FONT POINT-SIZE="10">CategoriaId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ProveedorId"><FONT POINT-SIZE="10">ProveedorId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Nombre"><FONT POINT-SIZE="10">Nombre</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Variante"><FONT POINT-SIZE="10">Variante</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Unidad"><FONT POINT-SIZE="10">Unidad</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Stock"><FONT POINT-SIZE="10">Stock</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_StockMinimo"><FONT POINT-SIZE="10">StockMinimo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_SeVendeSuelto"><FONT POINT-SIZE="10">SeVendeSuelto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_PrecioSuelto"><FONT POINT-SIZE="10">PrecioSuelto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Activo"><FONT POINT-SIZE="10">Activo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaRegistro"><FONT POINT-SIZE="10">FechaRegistro</FONT></TD></TR></TABLE>>];
  Categoria [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD><B>Categoria</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_CategoriaId"><FONT POINT-SIZE="10"><B>CategoriaId</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_Nombre"><FONT POINT-SIZE="10">Nombre</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Tipo"><FONT POINT-SIZE="10">Tipo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Activo"><FONT POINT-SIZE="10">Activo</FONT></TD></TR></TABLE>>];
  CorteCaja [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD><B>CorteCaja</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_CorteId"><FONT POINT-SIZE="10"><B>CorteId</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_UsuarioId"><FONT POINT-SIZE="10">UsuarioId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaApertura"><FONT POINT-SIZE="10">FechaApertura</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaCorte"><FONT POINT-SIZE="10">FechaCorte</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FondoInicial"><FONT POINT-SIZE="10">FondoInicial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaCierre"><FONT POINT-SIZE="10">FechaCierre</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_EfectivoContado"><FONT POINT-SIZE="10">EfectivoContado</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Estado"><FONT POINT-SIZE="10">Estado</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Observaciones"><FONT POINT-SIZE="10">Observaciones</FONT></TD></TR></TABLE>>];
  DetalleVenta [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD><B>DetalleVenta</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_DetalleVentaId"><FONT POINT-SIZE="10"><B>DetalleVentaId</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_VentaId"><FONT POINT-SIZE="10">VentaId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ProductoId"><FONT POINT-SIZE="10">ProductoId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ArticuloId"><FONT POINT-SIZE="10">ArticuloId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Cantidad"><FONT POINT-SIZE="10">Cantidad</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_PrecioUnitario"><FONT POINT-SIZE="10">PrecioUnitario</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Subtotal"><FONT POINT-SIZE="10">Subtotal</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Nota"><FONT POINT-SIZE="10">Nota</FONT></TD></TR></TABLE>>];
  DetalleVentaArticulo [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" STYLE="ROUNDED"><TR><TD><B>DetalleVentaArticulo</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_DetalleVentaId"><FONT POINT-SIZE="10"><B>DetalleVentaId (FK)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ArticuloId"><FONT POINT-SIZE="10"><B>ArticuloId (FK)</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_Cantidad"><FONT POINT-SIZE="10">Cantidad</FONT></TD></TR></TABLE>>];
  MovimientoInventario [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD><B>MovimientoInventario</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_MovimientoId"><FONT POINT-SIZE="10"><B>MovimientoId</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_ArticuloId"><FONT POINT-SIZE="10">ArticuloId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Tipo"><FONT POINT-SIZE="10">Tipo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Cantidad"><FONT POINT-SIZE="10">Cantidad</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_StockAnterior"><FONT POINT-SIZE="10">StockAnterior</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_StockNuevo"><FONT POINT-SIZE="10">StockNuevo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Fecha"><FONT POINT-SIZE="10">Fecha</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_UsuarioId"><FONT POINT-SIZE="10">UsuarioId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ProveedorId"><FONT POINT-SIZE="10">ProveedorId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_VentaId"><FONT POINT-SIZE="10">VentaId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Observaciones"><FONT POINT-SIZE="10">Observaciones</FONT></TD></TR></TABLE>>];
  Pago [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD><B>Pago</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_PagoId"><FONT POINT-SIZE="10"><B>PagoId</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_VentaId"><FONT POINT-SIZE="10">VentaId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_MetodoPago"><FONT POINT-SIZE="10">MetodoPago</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Monto"><FONT POINT-SIZE="10">Monto</FONT></TD></TR></TABLE>>];
  Producto [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD><B>Producto</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_ProductoId"><FONT POINT-SIZE="10"><B>ProductoId</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_Nombre"><FONT POINT-SIZE="10">Nombre</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Descripcion"><FONT POINT-SIZE="10">Descripcion</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Precio"><FONT POINT-SIZE="10">Precio</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Activo"><FONT POINT-SIZE="10">Activo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaRegistro"><FONT POINT-SIZE="10">FechaRegistro</FONT></TD></TR></TABLE>>];
  Proveedor [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD><B>Proveedor</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_ProveedorId"><FONT POINT-SIZE="10"><B>ProveedorId</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_Nombre"><FONT POINT-SIZE="10">Nombre</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Telefono"><FONT POINT-SIZE="10">Telefono</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Correo"><FONT POINT-SIZE="10">Correo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Activo"><FONT POINT-SIZE="10">Activo</FONT></TD></TR></TABLE>>];
  Usuario [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD><B>Usuario</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_UsuarioId"><FONT POINT-SIZE="10"><B>UsuarioId</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_NombreUsuario"><FONT POINT-SIZE="10">NombreUsuario</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_NombreCompleto"><FONT POINT-SIZE="10">NombreCompleto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Rol"><FONT POINT-SIZE="10">Rol</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Activo"><FONT POINT-SIZE="10">Activo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaRegistro"><FONT POINT-SIZE="10">FechaRegistro</FONT></TD></TR></TABLE>>];
  Venta [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD><B>Venta</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_VentaId"><FONT POINT-SIZE="10"><B>VentaId</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_CorteId"><FONT POINT-SIZE="10">CorteId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_UsuarioId"><FONT POINT-SIZE="10">UsuarioId (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Fecha"><FONT POINT-SIZE="10">Fecha</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_NombreOrden"><FONT POINT-SIZE="10">NombreOrden</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Tipo"><FONT POINT-SIZE="10">Tipo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Subtotal"><FONT POINT-SIZE="10">Subtotal</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Descuento"><FONT POINT-SIZE="10">Descuento</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_MotivoDescuento"><FONT POINT-SIZE="10">MotivoDescuento</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Total"><FONT POINT-SIZE="10">Total</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_EfectivoRecibido"><FONT POINT-SIZE="10">EfectivoRecibido</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Cambio"><FONT POINT-SIZE="10">Cambio</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Estado"><FONT POINT-SIZE="10">Estado</FONT></TD></TR></TABLE>>];
  Categoria -> Articulo [dir=both, style=dashed, arrowtail=none, arrowhead=dot, penwidth=1.2];
  Proveedor -> Articulo [dir=both, style=dashed, arrowtail=odiamond, arrowhead=dot, penwidth=1.2];
  Usuario -> CorteCaja [dir=both, style=dashed, arrowtail=none, arrowhead=dot, penwidth=1.2];
  Articulo -> DetalleVenta [dir=both, style=dashed, arrowtail=odiamond, arrowhead=dot, penwidth=1.2];
  Producto -> DetalleVenta [dir=both, style=dashed, arrowtail=odiamond, arrowhead=dot, penwidth=1.2];
  Venta -> DetalleVenta [dir=both, style=dashed, arrowtail=none, arrowhead=dot, penwidth=1.2];
  Articulo -> DetalleVentaArticulo [dir=both, style=solid, arrowtail=none, arrowhead=dot, penwidth=2];
  DetalleVenta -> DetalleVentaArticulo [dir=both, style=solid, arrowtail=none, arrowhead=dot, penwidth=2];
  Articulo -> MovimientoInventario [dir=both, style=dashed, arrowtail=none, arrowhead=dot, penwidth=1.2];
  Proveedor -> MovimientoInventario [dir=both, style=dashed, arrowtail=odiamond, arrowhead=dot, penwidth=1.2];
  Usuario -> MovimientoInventario [dir=both, style=dashed, arrowtail=none, arrowhead=dot, penwidth=1.2];
  Venta -> MovimientoInventario [dir=both, style=dashed, arrowtail=odiamond, arrowhead=dot, penwidth=1.2];
  Venta -> Pago [dir=both, style=dashed, arrowtail=none, arrowhead=dot, penwidth=1.2];
  CorteCaja -> Venta [dir=both, style=dashed, arrowtail=none, arrowhead=dot, penwidth=1.2];
  Usuario -> Venta [dir=both, style=dashed, arrowtail=none, arrowhead=dot, penwidth=1.2];
}
   "(`Stock` >= 0)"
  ],
  [
   "Articulo",
   "CK_Articulo_StockMin",
   "(`StockMinimo` >= 0)"
  ],
  [
   "CorteCaja",
   "CK_Corte_Estado",
   "(((`Estado` = _utf8mb4\\\\'Abierto\\\\') and (`FechaCierre` is null) and (`EfectivoContado` is null)) or ((`Estado` = _utf8mb4\\\\'Cerrado\\\\') and (`FechaCierre` is not null) and (`EfectivoContado` >= 0)))"
  ],
  [
   "CorteCaja",
   "CK_Corte_Fechas",
   "((`FechaCierre` is null) or (`FechaCierre` >= `FechaApertura`))"
  ],
  [
   "CorteCaja",
   "CK_Corte_Fondo",
   "(`FondoInicial` >= 0)"
  ],
  [

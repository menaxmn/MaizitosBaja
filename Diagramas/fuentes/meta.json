  ],
  [
   "DetalleVenta",
   "CK_Detalle_Origen",
   "(((`ProductoId` is not null) and (`ArticuloId` is null)) or ((`ProductoId` is null) and (`ArticuloId` is not null)))"
  ],
  [
   "DetalleVenta",
   "CK_Detalle_Precio",
   "(`PrecioUnitario` >= 0)"
  ],
  [
   "DetalleVenta",
   "CK_Detalle_Subtotal",
   "(`Subtotal` = (`Cantidad` * `PrecioUnitario`))"
  ],
  [
   "DetalleVentaArticulo",
   "CK_DVA_Cantidad",
   "(`Cantidad` > 0)"
  ],
  [
   "MovimientoInventario",
   "CK_Mov_Cantidad",
   "(`Cantidad` <> 0)"
  ],
  [
   "MovimientoInventario",
   "CK_Mov_Proveedor",
   "((`ProveedorId` is null) or (`Tipo` = _utf8mb4\\\\'Entrada\\\\'))"
  ],
  [
   "MovimientoInventario",
   "CK_Mov_Signo",
   "(((`Tipo` in (_utf8mb4\\\\'Inicial\\\\',_utf8mb4\\\\'Entrada\\\\',_utf8mb4\\\\'Cancelacion\\\\')) and (`Cantidad` > 0)) or ((`Tipo` in (_utf8mb4\\\\'Venta\\\\',_utf8mb4\\\\'ConsumoPersonal\\\\',_utf8mb4\\\\'Uso\\\\',_utf8mb4\\\\'Merma\\\\')) and (`Cantidad` < 0)) or (`Tipo` = _utf8mb4\\\\'Ajuste\\\\'))"
  ],
  [
   "MovimientoInventario",
   "CK_Mov_Venta",
   "(((`Tipo` in (_utf8mb4\\\\'Venta\\\\',_utf8mb4\\\\'ConsumoPersonal\\\\',_utf8mb4\\\\'Cancelacion\\\\')) and (`VentaId` is not null)) or ((`Tipo` not in (_utf8mb4\\\\'Venta\\\\',_utf8mb4\\\\'ConsumoPersonal\\\\',_utf8mb4\\\\'Cancelacion\\\\')) and (`VentaId` is null)))"
  ],
  [
   "Pago",
   "CK_Pago_Monto",
   "(`Monto` > 0)"
  ],
  [
   "Producto",
   "CK_Producto_Precio",
   "(`Precio` > 0)"
  ],
  [
   "Venta",
   "CK_Venta_Cambio",
   "(((`EfectivoRecibido` is null) and (`Cambio` is null)) or ((`EfectivoRecibido` > 0) and (`Cambio` >= 0) and (`Cambio` < `EfectivoRecibido`)))"
  ],
  [
   "Venta",
   "CK_Venta_Consumo",
   "((`Tipo` = _utf8mb4\\\\'Venta\\\\') or ((`Descuento` = 0) and (`EfectivoRecibido` is null)))"
  ],
  [
   "Venta",
   "CK_Venta_Descuento",
   "((`Descuento` >= 0) and (`Descuento` <= `Subtotal`))"
  ],
  [
   "Venta",
   "CK_Venta_Motivo",
   "((`Descuento` = 0) or (`MotivoDescuento` is not null))"
  ],
  [
   "Venta",
   "CK_Venta_Subtotal",
   "(`Subtotal` >= 0)"
  ],
  [
   "Venta",
   "CK_Venta_Total",
   "(`Total` = (`Subtotal` - `Descuento`))"
  ]

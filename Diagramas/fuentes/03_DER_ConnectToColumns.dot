OLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Estado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Observaciones" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Observaciones</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(200)</FONT></TD></TR></TABLE>>];

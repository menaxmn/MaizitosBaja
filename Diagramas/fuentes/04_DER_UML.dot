digraph ER {
  graph [rankdir=LR, fontname="Arial", fontsize=18, label="Maizitos Baja · DER en notación UML", labelloc=t, pad=0.3, nodesep=0.45, ranksep=1.3, splines=true, dpi=120];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#333333"];
  Articulo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5E9"><B>Articulo</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_ArticuloId"><FONT POINT-SIZE="10">«PK» <B>ArticuloId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_CategoriaId"><FONT POINT-SIZE="10">«FK» CategoriaId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ProveedorId"><FONT POINT-SIZE="10">«FK» ProveedorId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Nombre"><FONT POINT-SIZE="10">Nombre : VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Variante"><FONT POINT-SIZE="10">Variante : VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Unidad"><FONT POINT-SIZE="10">Unidad : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Stock"><FONT POINT-SIZE="10">Stock : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_StockMinimo"><FONT POINT-SIZE="10">StockMinimo : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_SeVendeSuelto"><FONT POINT-SIZE="10">SeVendeSuelto : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_PrecioSuelto"><FONT POINT-SIZE="10">PrecioSuelto : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Activo"><FONT POINT-SIZE="10">Activo : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaRegistro"><FONT POINT-SIZE="10">FechaRegistro : DATETIME</FONT></TD></TR></TABLE>>];
  Categoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5E9"><B>Categoria</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_CategoriaId"><FONT POINT-SIZE="10">«PK» <B>CategoriaId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Nombre"><FONT POINT-SIZE="10">Nombre : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Tipo"><FONT POINT-SIZE="10">Tipo : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Activo"><FONT POINT-SIZE="10">Activo : BOOLEAN</FONT></TD></TR></TABLE>>];
  CorteCaja [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5E9"><B>CorteCaja</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_CorteId"><FONT POINT-SIZE="10">«PK» <B>CorteId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_UsuarioId"><FONT POINT-SIZE="10">«FK» UsuarioId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaApertura"><FONT POINT-SIZE="10">FechaApertura : DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaCorte"><FONT POINT-SIZE="10">FechaCorte : DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FondoInicial"><FONT POINT-SIZE="10">FondoInicial : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaCierre"><FONT POINT-SIZE="10">FechaCierre : DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_EfectivoContado"><FONT POINT-SIZE="10">EfectivoContado : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Estado"><FONT POINT-SIZE="10">Estado : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Observaciones"><FONT POINT-SIZE="10">Observaciones : VARCHAR(200)</FONT></TD></TR></TABLE>>];
  DetalleVenta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5E9"><B>DetalleVenta</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_DetalleVentaId"><FONT POINT-SIZE="10">«PK» <B>DetalleVentaId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_VentaId"><FONT POINT-SIZE="10">«FK» VentaId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ProductoId"><FONT POINT-SIZE="10">«FK» ProductoId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ArticuloId"><FONT POINT-SIZE="10">«FK» ArticuloId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Cantidad"><FONT POINT-SIZE="10">Cantidad : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_PrecioUnitario"><FONT POINT-SIZE="10">PrecioUnitario : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Subtotal"><FONT POINT-SIZE="10">Subtotal : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Nota"><FONT POINT-SIZE="10">Nota : VARCHAR(150)</FONT></TD></TR></TABLE>>];
  DetalleVentaArticulo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5E9"><B>DetalleVentaArticulo</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_DetalleVentaId"><FONT POINT-SIZE="10">«PK» «FK» <B>DetalleVentaId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ArticuloId"><FONT POINT-SIZE="10">«PK» «FK» <B>ArticuloId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Cantidad"><FONT POINT-SIZE="10">Cantidad : INT</FONT></TD></TR></TABLE>>];
  MovimientoInventario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5E9"><B>MovimientoInventario</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_MovimientoId"><FONT POINT-SIZE="10">«PK» <B>MovimientoId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ArticuloId"><FONT POINT-SIZE="10">«FK» ArticuloId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Tipo"><FONT POINT-SIZE="10">Tipo : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Cantidad"><FONT POINT-SIZE="10">Cantidad : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_StockAnterior"><FONT POINT-SIZE="10">StockAnterior : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_StockNuevo"><FONT POINT-SIZE="10">StockNuevo : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Fecha"><FONT POINT-SIZE="10">Fecha : DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_UsuarioId"><FONT POINT-SIZE="10">«FK» UsuarioId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ProveedorId"><FONT POINT-SIZE="10">«FK» ProveedorId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_VentaId"><FONT POINT-SIZE="10">«FK» VentaId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Observaciones"><FONT POINT-SIZE="10">Observaciones : VARCHAR(200)</FONT></TD></TR></TABLE>>];
  Pago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5E9"><B>Pago</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_PagoId"><FONT POINT-SIZE="10">«PK» <B>PagoId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_VentaId"><FONT POINT-SIZE="10">«FK» VentaId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_MetodoPago"><FONT POINT-SIZE="10">MetodoPago : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Monto"><FONT POINT-SIZE="10">Monto : DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
  Producto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5E9"><B>Producto</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_ProductoId"><FONT POINT-SIZE="10">«PK» <B>ProductoId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Nombre"><FONT POINT-SIZE="10">Nombre : VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Descripcion"><FONT POINT-SIZE="10">Descripcion : VARCHAR(250)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Precio"><FONT POINT-SIZE="10">Precio : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Activo"><FONT POINT-SIZE="10">Activo : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaRegistro"><FONT POINT-SIZE="10">FechaRegistro : DATETIME</FONT></TD></TR></TABLE>>];
  Proveedor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5E9"><B>Proveedor</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_ProveedorId"><FONT POINT-SIZE="10">«PK» <B>ProveedorId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Nombre"><FONT POINT-SIZE="10">Nombre : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Telefono"><FONT POINT-SIZE="10">Telefono : VARCHAR(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Correo"><FONT POINT-SIZE="10">Correo : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Activo"><FONT POINT-SIZE="10">Activo : BOOLEAN</FONT></TD></TR></TABLE>>];
  Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5E9"><B>Usuario</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_UsuarioId"><FONT POINT-SIZE="10">«PK» <B>UsuarioId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_NombreUsuario"><FONT POINT-SIZE="10">NombreUsuario : VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_NombreCompleto"><FONT POINT-SIZE="10">NombreCompleto : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Rol"><FONT POINT-SIZE="10">Rol : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Activo"><FONT POINT-SIZE="10">Activo : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_FechaRegistro"><FONT POINT-SIZE="10">FechaRegistro : DATETIME</FONT></TD></TR></TABLE>>];
  Venta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5E9"><B>Venta</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="c_VentaId"><FONT POINT-SIZE="10">«PK» <B>VentaId</B> : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_CorteId"><FONT POINT-SIZE="10">«FK» CorteId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_UsuarioId"><FONT POINT-SIZE="10">«FK» UsuarioId : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Fecha"><FONT POINT-SIZE="10">Fecha : DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_NombreOrden"><FONT POINT-SIZE="10">NombreOrden : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Tipo"><FONT POINT-SIZE="10">Tipo : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Subtotal"><FONT POINT-SIZE="10">Subtotal : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Descuento"><FONT POINT-SIZE="10">Descuento : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_MotivoDescuento"><FONT POINT-SIZE="10">MotivoDescuento : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Total"><FONT POINT-SIZE="10">Total : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_EfectivoRecibido"><FONT POINT-SIZE="10">EfectivoRecibido : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Cambio"><FONT POINT-SIZE="10">Cambio : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_Estado"><FONT POINT-SIZE="10">Estado : ENUM</FONT></TD></TR></TABLE>>];
  Categoria -> Articulo [arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="CategoriaId", fontsize=8, fontcolor="#555555"];
  Proveedor -> Articulo [arrowhead=none, taillabel="0..1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="ProveedorId", fontsize=8, fontcolor="#555555"];
  Usuario -> CorteCaja [arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="UsuarioId", fontsize=8, fontcolor="#555555"];
  Articulo -> DetalleVenta [arrowhead=none, taillabel="0..1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="ArticuloId", fontsize=8, fontcolor="#555555"];
  Producto -> DetalleVenta [arrowhead=none, taillabel="0..1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="ProductoId", fontsize=8, fontcolor="#555555"];
  Venta -> DetalleVenta [arrowhead=none, taillabel="1", headlabel="1..*", labeldistance=2.2, labelfontsize=9, label="VentaId", fontsize=8, fontcolor="#555555"];
  Articulo -> DetalleVentaArticulo [arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="ArticuloId", fontsize=8, fontcolor="#555555"];
  DetalleVenta -> DetalleVentaArticulo [arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="DetalleVentaId", fontsize=8, fontcolor="#555555"];
  Articulo -> MovimientoInventario [arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="ArticuloId", fontsize=8, fontcolor="#555555"];
  Proveedor -> MovimientoInventario [arrowhead=none, taillabel="0..1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="ProveedorId", fontsize=8, fontcolor="#555555"];
  Usuario -> MovimientoInventario [arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="UsuarioId", fontsize=8, fontcolor="#555555"];
  Venta -> MovimientoInventario [arrowhead=none, taillabel="0..1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="VentaId", fontsize=8, fontcolor="#555555"];
  Venta -> Pago [arrowhead=none, taillabel="1", headlabel="0..3", labeldistance=2.2, labelfontsize=9, label="VentaId", fontsize=8, fontcolor="#555555"];
  CorteCaja -> Venta [arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="CorteId", fontsize=8, fontcolor="#555555"];
  Usuario -> Venta [arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2, labelfontsize=9, label="UsuarioId", fontsize=8, fontcolor="#555555"];
}
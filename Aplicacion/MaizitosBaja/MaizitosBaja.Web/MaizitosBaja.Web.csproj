<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ce12035d-4c23-482d-aeb6-c78ff800a770</UserSecretsId>
    <!-- Ícono del .exe (el logo de Maizitos Baja) -->
    <ApplicationIcon>icono.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Versión instalada (Release): sin ventana negra de consola -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MaizitosBaja.Datos\MaizitosBaja.Datos.csproj" />
    <ProjectReference Include="..\MaizitosBaja.Entidades\MaizitosBaja.Entidades.csproj" />
    <ProjectReference Include="..\MaizitosBaja.Negocios\MaizitosBaja.Negocios.csproj" />
  </ItemGroup>

</Project>

@page
@model MaizitosBaja.Web.Pages.Sistema.CerrarModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Maizitos Baja</title>
    <link rel="icon" type="image/png" href="~/img/icono.png" />
    <style>
        body {
            margin: 0; min-height: 100vh;
            display: grid; place-items: center;
            background: #1F1D17; color: #F3ECD3;
            font-family: "Nunito", "Segoe UI", system-ui, sans-serif; text-align: center;
        }
        img { width: 170px; margin-bottom: 12px; }
        h1 { font-family: "Lilita One", "Arial Rounded MT Bold", sans-serif; font-weight: 400; color: #FFD21F; margin: 0 0 6px; }
        p { color: #B9B092; margin: 0; }
    </style>
</head>
<body>
    <div>
        <img src="~/img/logo.png" alt="Maizitos Baja" />
        <h1>Sistema cerrado</h1>
        <p>Ya puedes cerrar esta ventana. Para volver a usarlo, abre el ícono de Maizitos Baja.</p>
    </div>
    <script>setTimeout(() => window.close(), 1500);</script>
</body>
</html>

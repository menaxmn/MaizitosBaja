@model MaizitosBaja.Web.Pages.Productos.ProductoInput

<form method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="ProductoId" />

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Esquite con Takis" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
            <div class="form-text">
                Tip: si el platillo viene en tamaños, nómbralos igual y termina con
                <b>chico</b>, <b>mediano</b> o <b>grande</b> (ej. "Esquite chico", "Esquite grande").
                En Vender saldrán juntos en una sola tarjeta.
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"
                      placeholder="Ej. Grano de elote, mayonesa, queso, chile y limón (opcional)"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>

        <div class="mb-1" style="max-width: 220px">
            <label asp-for="Precio" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <span asp-validation-for="Precio" class="text-danger small"></span>
        </div>
        @if (Model.ProductoId != 0)
        {
            <div class="form-text">Cambiar el precio no afecta las ventas que ya se hicieron.</div>
        }
    </div>

    <div class="card-footer d-flex gap-2 justify-content-end">
        <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-warning">
            @(Model.ProductoId == 0 ? "Agregar al menú" : "Guardar cambios")
        </button>
    </div>
</form>

@page "{id:int}"
@model MaizitosBaja.Web.Pages.Ticket.IndexModel
@{
    Layout = null;   // página sola, sin menú, para imprimir
    var t = Model.Venta!;
    var n = Model.Negocio;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Ticket #@t.VentaId - @n.Nombre</title>
    <style>
        /* Rollo de 80 mm: el área que imprime es de unos 72 mm */
        @@page { size: 80mm 200mm; margin: 0; }

        body {
            margin: 0;
            background: #e9ecef;
            font-family: "Courier New", Consolas, monospace;
            font-size: 12px;
            color: #000;
        }
        .ticket {
            width: 72mm;
            margin: 12px auto;
            padding: 4mm;
            background: #fff;
            box-sizing: content-box;
        }
        .centro { text-align: center; }
        .negrita { font-weight: bold; }
        .grande { font-size: 18px; }
        .chico { font-size: 11px; }
        .linea { border-top: 1px dashed #000; margin: 6px 0; }
        .fila { display: flex; justify-content: space-between; gap: 6px; }
        .fila span:last-child { white-space: nowrap; }
        .detalle { padding-left: 12px; font-size: 11px; }
        .total { font-size: 16px; font-weight: bold; }
        .sello {
            border: 2px solid #000; padding: 4px; margin: 6px 0;
            text-align: center; font-weight: bold; font-size: 14px;
        }
        .botones { text-align: center; margin: 12px; font-family: Arial, sans-serif; }
        .botones button { font-size: 15px; padding: 8px 16px; margin: 0 4px; cursor: pointer; }

        @@media print {
            body { background: #fff; }
            .ticket { margin: 0; }
            .no-imprimir { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="botones no-imprimir">
        <button type="button" onclick="imprimirTicket()">🖨️ Imprimir / Guardar PDF</button>
        <button type="button" onclick="window.close()">Cerrar</button>
    </div>

    <div class="ticket" id="ticket">
        <!-- Encabezado -->
        <div class="centro">
            <div class="negrita grande">@n.Nombre</div>
            @if (!string.IsNullOrWhiteSpace(n.Lema)) { <div>@n.Lema</div> }
            @if (!string.IsNullOrWhiteSpace(n.Direccion)) { <div class="chico">@n.Direccion</div> }
            @if (!string.IsNullOrWhiteSpace(n.Telefono)) { <div class="chico">Tel. @n.Telefono</div> }
        </div>

        <div class="linea"></div>

        <div class="fila"><span>Folio: <b>#@t.VentaId</b></span><span>@t.Fecha.ToString("dd/MM/yyyy")</span></div>
        <div class="fila"><span>@(t.NombreOrden != null ? "Orden: " + t.NombreOrden : "")</span><span>@t.Fecha.ToString("hh:mm tt")</span></div>

        @if (t.Estado == "Cancelada")
        {
            <div class="sello">*** VENTA CANCELADA ***</div>
        }
        @if (t.Tipo == "ConsumoPersonal")
        {
            <div class="sello">CONSUMO PERSONAL<br />(sin cobro)</div>
        }

        <div class="linea"></div>

        <!-- Renglones -->
        @foreach (var r in t.Renglones)
        {
            <div class="fila"><span>@r.Cantidad @r.Concepto</span><span>@r.Subtotal.ToString("C")</span></div>
            if (r.Cantidad > 1)
            {
                <div class="detalle">@r.PrecioUnitario.ToString("C") c/u</div>
            }
            if (!string.IsNullOrEmpty(r.Elegidos))
            {
                <div class="detalle">+ @r.Elegidos</div>
            }
            if (!string.IsNullOrEmpty(r.Nota))
            {
                <div class="detalle">* @r.Nota</div>
            }
        }

        <div class="linea"></div>

        <!-- Totales -->
        @if (t.Descuento > 0)
        {
            <div class="fila"><span>Subtotal</span><span>@t.Subtotal.ToString("C")</span></div>
            <div class="fila"><span>@("Descuento" + (t.MotivoDescuento != null ? " (" + t.MotivoDescuento + ")" : ""))</span><span>-@t.Descuento.ToString("C")</span></div>
        }
        <div class="fila total"><span>TOTAL</span><span>@(t.Tipo == "ConsumoPersonal" ? "$0.00" : t.Total.ToString("C"))</span></div>

        @if (t.Pagos.Count > 0)
        {
            <div class="linea"></div>
            foreach (var p in t.Pagos)
            {
                <div class="fila"><span>@p.Metodo</span><span>@p.Monto.ToString("C")</span></div>
            }
            if (t.EfectivoRecibido.HasValue)
            {
                <div class="fila"><span>Pagó con</span><span>@t.EfectivoRecibido.Value.ToString("C")</span></div>
                <div class="fila negrita"><span>Cambio</span><span>@((t.Cambio ?? 0).ToString("C"))</span></div>
            }
        }

        <div class="linea"></div>

        <!-- Pie -->
        <div class="centro">
            <div class="negrita">@n.Agradecimiento</div>
            @if (!string.IsNullOrWhiteSpace(n.Facebook) || !string.IsNullOrWhiteSpace(n.Instagram) || !string.IsNullOrWhiteSpace(n.TikTok))
            {
                <div class="chico" style="margin-top: 4px">Síguenos en redes:</div>
                if (!string.IsNullOrWhiteSpace(n.Facebook)) { <div class="chico">Facebook: @n.Facebook</div> }
                if (!string.IsNullOrWhiteSpace(n.Instagram)) { <div class="chico">Instagram: @n.Instagram</div> }
                if (!string.IsNullOrWhiteSpace(n.TikTok)) { <div class="chico">TikTok: @n.TikTok</div> }
            }
        </div>
    </div>

    <script>
        // Ajusta el largo de la hoja al largo del ticket (así el PDF
        // no sale con espacio en blanco) y abre el diálogo de impresión.
        function imprimirTicket() {
            const ticket = document.getElementById('ticket');
            const altoMm = Math.ceil(ticket.offsetHeight * 25.4 / 96) + 4;

            let estilo = document.getElementById('tamanoHoja');
            if (!estilo) {
                estilo = document.createElement('style');
                estilo.id = 'tamanoHoja';
                document.head.appendChild(estilo);
            }
            estilo.textContent = '@@page { size: 80mm ' + altoMm + 'mm; margin: 0; }';

            window.print();
        }

        @if (Model.Imprimir)
        {
            <text>window.addEventListener('load', imprimirTicket);</text>
        }
    </script>
</body>
</html>
